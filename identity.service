# Install at /etc/systemd/system/identity.service (root:root 0644), then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now identity.service
# Prerequisites: deploy account exists; `sudo loginctl enable-linger deploy`
# (so /run/user/<deploy-uid> exists at boot for rootless podman); /opt/identity/
# contains deploy.sh (root:root 0755) + podman-compose.yml (root:root 0644) +
# .deploy (deploy-owned, writable); and deploy can pull the GHCR image (package
# is PUBLIC, or `sudo -u deploy podman login ghcr.io` was run on the server).

[Unit]
Description=identity podman-compose service (runs as deploy)
Documentation=file:///opt/identity/podman-compose.yml
Wants=network-online.target
After=network-online.target podman.socket

[Service]
Type=oneshot
RemainAfterExit=yes
User=deploy
Group=deploy
WorkingDirectory=/opt/identity
Environment=HOME=/home/deploy
Environment=XDG_RUNTIME_DIR=/run/user/%U
EnvironmentFile=-/opt/identity/.deploy

ExecStartPre=-/bin/sh -c 'cd /opt/identity && C="$(command -v podman-compose >/dev/null 2>&1 && echo podman-compose || echo podman\ compose)"; exec $C -f /opt/identity/podman-compose.yml down'
ExecStart=/bin/sh -c 'cd /opt/identity && C="$(command -v podman-compose >/dev/null 2>&1 && echo podman-compose || echo podman\ compose)"; exec $C -f /opt/identity/podman-compose.yml up -d'
ExecStop=/bin/sh -c 'cd /opt/identity && C="$(command -v podman-compose >/dev/null 2>&1 && echo podman-compose || echo podman\ compose)"; exec $C -f /opt/identity/podman-compose.yml down'

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
